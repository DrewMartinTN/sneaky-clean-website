{
  "name": "sneaky-clean-booking",
  "version": "1.0.0",
  "description": "Branded booking buttons for SneakyCleanTN.com that show your own date/time picker, then create real Square Appointments bookings under the hood. No Square iframe, no \"Price varies\" labels, no choose-a-service detour — customer clicks a button → modal opens → picks date/time → confirms → booking lands in your Square dashboard for acceptance.",
  "main": "worker.js",
  "scripts": {
    "dev": "python3 -m http.server 8787 --directory .",
    "dev:site": "python3 -m http.server 8787 --directory .",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "site:generate": "node scripts/site/generate-seo-pages.mjs",
    "images:prepare": "node scripts/images/prepare-images.mjs",
    "images:responsive": "node scripts/images/generate-responsive-site-images.mjs",
    "images:sort": "node scripts/images/photo-sorter.mjs",
    "images:import-drive": "node scripts/images/drive-importer.mjs",
    "square:setup-groups": "node scripts/square/setup-groups.mjs",
    "square:audit": "node scripts/square/customer-audit.mjs",
    "square:retention": "node scripts/square/retention-report.mjs",
    "square:apply-groups": "node scripts/square/apply-suggested-groups.mjs",
    "square:membership": "node scripts/square/membership-report.mjs",
    "square:add-item": "node scripts/square/add-catalog-item.mjs",
    "square:setup-popup": "node scripts/square/setup-popup.mjs",
    "square:popup-report": "node scripts/square/popup-report.mjs",
    "square:create-popup-event": "node scripts/square/create-popup-event.mjs",
    "site:popup-qr": "node scripts/site/generate-popup-qr.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "qrcode": "^1.5.4",
    "wrangler": "^4.110.0"
  }
}
